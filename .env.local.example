# Cloud Agent Status API Key
# Get your API key from: https://cursor.com/dashboard → API Keys
# This enables the dashboard to show live status for F.R.I.D.A.Y. and Bumblebee
# cloud agents. Without this key, cloud agent status polling is disabled.
#
# Copy this file to .env.local and add your key:
#   cp .env.local.example .env.local
#
# Key format: crsr_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CURSOR_API_KEY=
