{
  "name": "ai-agent-dashboard",
  "version": "1.0.0",
  "description": "Retro pixel-art AI agent dashboard with JEV-style task orchestration",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node tests/cloudAgentPoller.test.cjs && node tests/hookLifecycle.test.cjs && node tests/claudeCodeHook.test.cjs",
    "electron": "npm run build && electron .",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\""
  },
  "dependencies": {
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.3.2",
    "vite": "^5.0.4",
    "wait-on": "^7.2.0"
  }
}
